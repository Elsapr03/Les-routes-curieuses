---
const tabs = [
  { id: 'blog', label: 'Blog' },
  { id: 'roadbooks', label: 'Roadbooks' },
  { id: 'sur-mesure', label: 'Sur mesure' },
  { id: 'contacts', label: 'Contacts' },
];
---
<!doctype html>
<html lang="fr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex,nofollow" />
<title>Administration — Les Routes Curieuses</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet" />
<style>
:root{--cream:#faf8f2;--paper:#fffdf8;--ink:#263d52;--muted:#63727a;--terra:#b96f4d;--terra-soft:#f5eae3;--sage:#dce5d6;--line:#dddcd4;--navy:#263d52}
*{box-sizing:border-box}
body{margin:0;background:var(--cream);color:var(--ink);font:15px/1.6 'DM Sans',Arial,sans-serif}
button,input,textarea,select{font:inherit;color:inherit}
button{cursor:pointer}
a{color:inherit}
.shell{width:min(1180px,calc(100% - 32px));margin:auto}
.topbar{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:22px 0}
.brand{font:1.55rem 'DM Serif Display',Georgia,serif;text-decoration:none}
.top-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.top-actions a{font-size:.82rem;font-weight:700;text-decoration:none;padding:8px 11px;border:1px solid var(--line);background:var(--paper)}
.hero{padding:44px 0 28px}
.eyebrow{margin:0 0 8px;color:var(--terra);text-transform:uppercase;font-size:.7rem;font-weight:700;letter-spacing:.14em}
h1,h2,h3{font-family:'DM Serif Display',Georgia,serif;font-weight:400}
h1{font-size:clamp(2.6rem,5vw,4.5rem);line-height:1.05;margin:8px 0 12px}
.hero p:last-child{max-width:690px;color:var(--muted);font-size:1rem}
.notice{margin:20px 0 26px;padding:14px 18px;border-left:4px solid var(--terra);background:var(--terra-soft);font-size:.88rem}
.admin{display:grid;grid-template-columns:210px minmax(0,1fr);gap:28px;padding-bottom:70px}
.sidebar{position:sticky;top:18px;align-self:start;padding:12px;background:#ebe8e0;border:1px solid var(--line);border-radius:12px}
.tab{width:100%;border:0;background:transparent;text-align:left;padding:13px 14px;border-radius:8px;font-weight:700;color:#545c62}
.tab.active{background:var(--paper);color:var(--ink);box-shadow:0 2px 8px rgba(38,61,82,.08)}
.tab + .tab{margin-top:4px}
.panel{display:none}
.panel.active{display:block}
.panel-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:22px}
.panel-head h2{font-size:2.15rem;margin:0 0 5px}
.panel-head p{margin:0;color:var(--muted)}
.primary,.secondary,.danger{min-height:42px;padding:10px 14px;border-radius:5px;font-weight:700}
.primary{border:1px solid var(--navy);background:var(--navy);color:white}
.secondary{border:1px solid var(--line);background:var(--paper)}
.danger{border:1px solid #caa79c;background:#fff5f1;color:#8a4c3c}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.card{background:var(--paper);border:1px solid var(--line);border-radius:9px;padding:22px}
.card h3{margin:0 0 6px;font-size:1.35rem}
.card p{margin:4px 0;color:var(--muted)}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:22px}
.stat{background:var(--paper);border:1px solid var(--line);padding:17px;border-radius:8px}
.stat strong{display:block;font:2rem 'DM Serif Display',Georgia,serif}
.stat span{color:var(--muted);font-size:.8rem}
.list{display:grid;gap:12px}
.item{background:var(--paper);border:1px solid var(--line);padding:18px;border-radius:8px}
.item-top{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}
.item h3{margin:0 0 5px;font-size:1.13rem}
.meta{color:var(--muted);font-size:.8rem}
.pill{display:inline-flex;align-items:center;padding:5px 9px;border-radius:999px;background:var(--sage);font-size:.72rem;font-weight:700;white-space:nowrap}
.item-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:13px}
.item-actions button{padding:7px 10px;border:1px solid var(--line);background:#f5f3ec;border-radius:4px;font-weight:700;font-size:.8rem}
.form-card{background:#efede6;border:1px solid var(--line);border-radius:9px;padding:22px;margin-bottom:22px}
.form-card[hidden]{display:none}
.form-card h3{margin:0 0 16px;font-size:1.45rem}
.field{margin-bottom:16px}
.field label{display:block;font-weight:700;font-size:.83rem;margin-bottom:6px}
.field input,.field textarea,.field select{width:100%;padding:11px 12px;border:1px solid #c6c7c2;border-radius:4px;background:#fff}
.field textarea{min-height:115px;resize:vertical}
.field small{display:block;margin-top:5px;color:var(--muted);font-size:.74rem}
.form-actions{display:flex;gap:9px;flex-wrap:wrap}
.empty{padding:28px;border:1px dashed #c9c6bc;border-radius:8px;text-align:center;color:var(--muted);background:rgba(255,255,255,.35)}
.request{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:15px}
.request-details{grid-column:1/-1;border-top:1px solid var(--line);padding-top:13px;margin-top:4px}
.request-details[hidden]{display:none}
.request-details p{margin:5px 0}
.request-details select{padding:7px 9px;border:1px solid var(--line);background:white}
.contact-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:16px}
.admin-embed-frame{display:block;width:100%;min-height:1200px;border:0;background:transparent}
.archive-head{display:flex;justify-content:space-between;align-items:end;gap:18px;margin:34px 0 16px}
.archive-head h3{margin:0 0 4px}
.rich-toolbar{display:flex;flex-wrap:wrap;gap:7px;padding:9px;border:1px solid #c6c7c2;border-bottom:0;border-radius:7px 7px 0 0;background:#f3f1ea}
.rich-toolbar button{min-height:36px;padding:7px 10px;border:1px solid var(--line);border-radius:4px;background:#fff;font-size:.8rem;font-weight:700}
.rich-toolbar button:hover{background:#f7f5ef}
.blog-editor{min-height:420px;padding:20px;border:1px solid #c6c7c2;border-radius:0 0 7px 7px;background:#fff;line-height:1.75;outline:none}
.blog-editor:empty:before{content:attr(data-placeholder);color:#9a9b95}
.blog-editor:focus{border-color:#9ea8aa;box-shadow:0 0 0 3px rgba(185,111,77,.12)}
.blog-editor h2{margin:1.8em 0 .65em;font:400 1.8rem/1.2 'DM Serif Display',Georgia,serif}
.blog-editor blockquote{margin:1.5em 0;padding:12px 18px;border-left:4px solid var(--terra);background:#f7f1eb}
.blog-editor figure{margin:24px 0}
.blog-editor figure img{display:block;max-width:100%;height:auto;border-radius:7px}
.blog-editor figcaption{margin-top:7px;color:var(--muted);font-size:.8rem}
.editor-hint{margin:8px 0 0;color:var(--muted);font-size:.78rem}
@media(max-width:720px){.archive-head{align-items:flex-start;flex-direction:column}.blog-editor{min-height:330px}}
.archive-filter{display:flex;align-items:center;gap:8px}
.archive-filter label{font-weight:700;font-size:.8rem}
.archive-filter select{padding:8px 10px;border:1px solid var(--line);background:var(--paper)}
.archive-head{margin-top:34px}
.pdf-field{padding:16px;border:1px solid var(--line);border-radius:7px;background:#f7f5ef}
.pdf-preview{margin-top:10px}
.pdf-preview a{display:inline-block;padding:8px 11px;border:1px solid var(--line);border-radius:4px;background:#fff;text-decoration:none;font-weight:700;font-size:.8rem}
@media(max-width:820px){
  .admin{grid-template-columns:1fr}
  .sidebar{position:static;display:flex;overflow-x:auto}
  .tab{min-width:max-content;width:auto}
  .tab + .tab{margin-top:0;margin-left:4px}
  .grid,.stats{grid-template-columns:1fr}
}
@media(max-width:580px){
  .shell{width:min(100% - 22px,1180px)}
  .topbar,.panel-head,.item-top{align-items:flex-start;flex-direction:column}
  .request,.contact-row{grid-template-columns:1fr}
  .card,.form-card{padding:16px}
}
</style>
</head>
<body>
<header class="shell topbar">
  <a href="/" class="brand">Les Routes Curieuses</a>
  <div class="top-actions">
    <a href="/">Voir le site</a>
    <a href="/sur-mesure/">Voir le sur-mesure</a>
  </div>
</header>

<main class="shell">
  <section class="hero">
    <p class="eyebrow">Espace administration · Version de test</p>
    <h1>Tout gérer au même endroit.</h1>
    <p>Un espace unique pour les articles du blog, les roadbooks, les demandes sur mesure et les contacts.</p>
  </section>

  <div class="notice">
    <strong>Maquette de fonctionnement.</strong> Les contenus créés ici restent uniquement dans ce navigateur pour le test. Aucune donnée cliente réelle n’est affichée ni enregistrée tant que l’accès privé et le stockage Cloudflare ne sont pas branchés.
  </div>

  <div class="admin">
    <nav class="sidebar" aria-label="Administration">
      {tabs.map((tab, index) => (
        <button class:list={['tab',{active:index===0}]} type="button" data-tab={tab.id}>{tab.label}</button>
      ))}
    </nav>

    <div>
      <section class="panel active" id="panel-blog">
        <div class="panel-head">
          <div><p class="eyebrow">Contenus éditoriaux</p><h2>Blog</h2><p>Écrire, mettre en forme et retrouver tous les anciens articles.</p></div>
          <button class="primary" type="button" data-new="blog">Nouvel article</button>
        </div>

        <div class="form-card" id="blog-form" hidden>
          <h3 id="blog-form-title">Nouvel article</h3>

          <div class="grid">
            <div class="field"><label for="blog-title">Titre</label><input id="blog-title" type="text" /></div>
            <div class="field"><label for="blog-category">Catégorie</label><select id="blog-category"><option>Récits de voyage</option><option>Petit budget</option><option>Bas carbone</option><option>Voyage en solo</option><option>Bonnes adresses</option></select></div>
          </div>

          <div class="field"><label for="blog-summary">Résumé</label><textarea id="blog-summary"></textarea></div>

          <div class="grid">
            <div class="field"><label for="blog-date">Date</label><input id="blog-date" type="date" /></div>
            <div class="field"><label for="blog-status">Statut</label><select id="blog-status"><option value="draft">Brouillon</option><option value="published">Publié</option><option value="archived">Archivé</option></select></div>
          </div>

          <div class="field">
            <label>Contenu de l’article</label>
            <div class="rich-toolbar" aria-label="Mise en forme de l'article">
              <button type="button" data-editor-command="bold"><strong>Gras</strong></button>
              <button type="button" data-editor-command="italic"><em>Italique</em></button>
              <button type="button" data-editor-block="h2">Sous-titre</button>
              <button type="button" data-editor-block="blockquote">Citation</button>
              <button type="button" id="insert-image-button">+ Ajouter une photo ici</button>
            </div>
            <div id="blog-editor" class="blog-editor" contenteditable="true" role="textbox" aria-multiline="true" data-placeholder="Écrivez votre article ici…"></div>
            <p class="editor-hint">Placez le curseur à l’endroit voulu avant d’ajouter une photo. Vous pourrez ensuite continuer à écrire juste en dessous.</p>
          </div>

          <div class="form-actions">
            <button class="primary" type="button" id="save-blog">Enregistrer</button>
            <button class="secondary" type="button" data-cancel="blog">Annuler</button>
          </div>
        </div>

        <div class="archive-head">
          <div>
            <p class="eyebrow">Tous les contenus</p>
            <h3>Archives et anciens articles</h3>
            <p class="meta">Les articles existants restent accessibles et modifiables ici.</p>
          </div>
          <div class="archive-filter">
            <label for="blog-filter">Afficher</label>
            <select id="blog-filter">
              <option value="all">Tous</option>
              <option value="published">Publiés</option>
              <option value="draft">Brouillons</option>
              <option value="archived">Archivés</option>
            </select>
          </div>
        </div>

        <div class="list" id="blog-list"></div>
      </section>

      <section class="panel" id="panel-roadbooks">
        <div class="panel-head">
          <div><p class="eyebrow">Produits numériques</p><h2>Roadbooks</h2><p>Gérer les destinations, descriptifs, durées et tarifs.</p></div>
          <button class="primary" type="button" data-new="roadbook">Nouveau roadbook</button>
        </div>
        <div class="form-card" id="roadbook-form" hidden>
          <h3 id="roadbook-form-title">Nouveau roadbook</h3>
          <div class="grid">
            <div class="field"><label for="roadbook-title">Destination / titre</label><input id="roadbook-title" type="text" /></div>
            <div class="field"><label for="roadbook-duration">Durée (jours)</label><input id="roadbook-duration" type="number" min="1" /></div>
          </div>
          <div class="grid">
            <div class="field"><label for="roadbook-transport">Transports</label><input id="roadbook-transport" type="text" placeholder="Train, bus, vélo…" /></div>
            <div class="field"><label for="roadbook-price">Prix du roadbook (€)</label><input id="roadbook-price" type="number" min="0" step="1" /></div>
          </div>
          <div class="field"><label for="roadbook-summary">Présentation</label><textarea id="roadbook-summary"></textarea></div>

          <div class="field pdf-field">
            <label for="roadbook-pdf">PDF du roadbook</label>
            <input id="roadbook-pdf" type="url" placeholder="Adresse du PDF pour cette maquette" />
            <small>Dans la version finale, ce champ deviendra un bouton « Choisir un PDF » ou « Remplacer le PDF ».</small>
            <div id="roadbook-pdf-preview" class="pdf-preview" hidden>
              <a id="roadbook-pdf-link" href="#" target="_blank" rel="noopener">Ouvrir le PDF actuel</a>
            </div>
          </div>

          <div class="field"><label for="roadbook-status">Affichage</label><select id="roadbook-status"><option value="draft">Masqué</option><option value="published">Visible sur le site</option></select></div>
          <div class="form-actions"><button class="primary" type="button" id="save-roadbook">Enregistrer</button><button class="secondary" type="button" data-cancel="roadbook">Annuler</button></div>
        </div>
        <div class="list" id="roadbook-list"></div>
      </section>

      <section class="panel" id="panel-sur-mesure">
        <div class="panel-head">
          <div><p class="eyebrow">Demandes clients</p><h2>Sur mesure</h2><p>Suivre les demandes, les étapes de préparation, les échéances et les notes.</p></div>
        </div>
        <iframe
          id="sur-mesure-frame"
          class="admin-embed-frame"
          src="/apercu-gestion?embed=1"
          title="Suivi des demandes de roadbooks sur mesure"
        ></iframe>
      </section>

      <section class="panel" id="panel-contacts">
        <div class="panel-head">
          <div><p class="eyebrow">Messages généraux</p><h2>Contacts</h2><p>Centraliser les questions qui ne concernent pas une demande de roadbook sur mesure.</p></div>
        </div>
        <div class="list">
          <article class="item contact-row"><div><h3>Question sur un roadbook</h3><p class="meta">Exemple fictif · message reçu aujourd’hui</p><p>« Le roadbook comprend-il aussi les cartes et les liens pratiques ? »</p></div><span class="pill">Nouveau</span></article>
          <article class="item contact-row"><div><h3>Demande de partenariat</h3><p class="meta">Exemple fictif · message reçu il y a 3 jours</p><p>« Je souhaiterais échanger autour d’un contenu commun sur le voyage en train. »</p></div><span class="pill">À traiter</span></article>
        </div>
      </section>
    </div>
  </div>
</main>

<script>
const $ = (s) => document.querySelector(s);
const $$ = (s) => [...document.querySelectorAll(s)];
const STORE_BLOG = 'routes-curieuses-admin-blog-demo-v1';
const STORE_ROADBOOKS = 'routes-curieuses-admin-roadbooks-demo-v1';
let blogItems = [];
let roadbookItems = [];
let blogEdit = null;
let roadbookEdit = null;

function read(key, fallback){ try { const value=JSON.parse(localStorage.getItem(key)||'null'); return Array.isArray(value)?value:fallback; } catch { return fallback; } }
function write(key, value){ localStorage.setItem(key, JSON.stringify(value)); }
function esc(value){ return String(value ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[ch])); }

function showTab(name){
  $$('.tab').forEach(b=>b.classList.toggle('active',b.dataset.tab===name));
  $$('.panel').forEach(p=>p.classList.toggle('active',p.id===`panel-${name}`));
  history.replaceState(null,'',`#${name}`);
}
$$('.tab').forEach(b=>b.addEventListener('click',()=>showTab(b.dataset.tab)));
const initial=location.hash.slice(1); if(['blog','roadbooks','sur-mesure','contacts'].includes(initial)) showTab(initial);

function blocksToHtml(blocks){
  if(!Array.isArray(blocks)) return '';
  return blocks.map(block=>{
    if(block.type==='heading') return `<h2>${esc(block.text)}</h2>`;
    if(block.type==='image') return `<figure><img src="${esc(block.url)}" alt=""><figcaption>${esc(block.caption||'')}</figcaption></figure>`;
    return `<p>${esc(block.text||'')}</p>`;
  }).join('');
}
function openForm(kind, index=null){
  const el=$(`#${kind}-form`); el.hidden=false;
  if(kind==='blog'){
    blogEdit=index; const item=index===null?null:blogItems[index];
    $('#blog-form-title').textContent=item?'Modifier l’article':'Nouvel article';
    $('#blog-title').value=item?.title||'';
    $('#blog-category').value=item?.category||'Récits de voyage';
    $('#blog-summary').value=item?.summary||'';
    $('#blog-date').value=item?.date||new Date().toISOString().slice(0,10);
    $('#blog-status').value=item?.status||'draft';
    $('#blog-editor').innerHTML=item?.html || blocksToHtml(item?.blocks) || '';
  }else{
    roadbookEdit=index; const item=index===null?null:roadbookItems[index];
    $('#roadbook-form-title').textContent=item?'Modifier le roadbook':'Nouveau roadbook';
    $('#roadbook-title').value=item?.title||''; $('#roadbook-duration').value=item?.duration||'';
    $('#roadbook-transport').value=item?.transport||''; $('#roadbook-price').value=item?.price||'';
    $('#roadbook-summary').value=item?.summary||'';
    $('#roadbook-pdf').value=item?.pdf||'';
    updateRoadbookPdfPreview();
    $('#roadbook-status').value=item?.status||'draft';
  }
  el.scrollIntoView({behavior:'smooth',block:'start'});
}
$$('[data-new]').forEach(b=>b.addEventListener('click',()=>openForm(b.dataset.new)));
$$('[data-cancel]').forEach(b=>b.addEventListener('click',()=>{$(`#${b.dataset.cancel}-form`).hidden=true;}));

$$('[data-editor-command]').forEach(button=>button.addEventListener('click',()=>{
  $('#blog-editor').focus();
  document.execCommand(button.dataset.editorCommand,false,null);
}));
$$('[data-editor-block]').forEach(button=>button.addEventListener('click',()=>{
  $('#blog-editor').focus();
  document.execCommand('formatBlock',false,button.dataset.editorBlock);
}));

$('#insert-image-button').addEventListener('click',()=>{
  const editor=$('#blog-editor');
  editor.focus();
  const url=prompt("Adresse de la photo (pour cette maquette de test) :");
  if(!url) return;
  const caption=prompt("Légende de la photo (facultatif) :") || '';
  const html=`<figure contenteditable="false"><img src="${esc(url)}" alt=""><figcaption>${esc(caption)}</figcaption></figure><p><br></p>`;
  document.execCommand('insertHTML',false,html);
});

function renderBlog(){
  const list=$('#blog-list');
  const filter=$('#blog-filter')?.value||'all';
  const filtered=blogItems.filter(x=>filter==='all'||x.status===filter);
  if(!filtered.length){list.innerHTML='<div class="empty">Aucun article pour ce filtre.</div>';return;}
  list.innerHTML=filtered.map(x=>{
    const i=blogItems.indexOf(x);
    const photoCount=((x.html||'').match(/<img\b/g)||[]).length || (x.blocks||[]).filter(b=>b.type==='image'&&b.url).length;
    const statusLabel=x.status==='published'?'Publié':x.status==='archived'?'Archivé':'Brouillon';
    return `<article class="item"><div class="item-top"><div><h3>${esc(x.title)}</h3><p class="meta">${esc(x.category)} · ${esc(x.date)} · ${photoCount} photo(s)</p></div><span class="pill">${statusLabel}</span></div><p>${esc(x.summary)}</p><div class="item-actions"><button data-blog-edit="${i}">Modifier</button><button data-blog-duplicate="${i}">Dupliquer</button><button data-blog-delete="${i}">Supprimer</button></div></article>`;
  }).join('');
  $$('[data-blog-edit]').forEach(b=>b.addEventListener('click',()=>openForm('blog',Number(b.dataset.blogEdit))));
  $$('[data-blog-duplicate]').forEach(b=>b.addEventListener('click',()=>{const original=blogItems[Number(b.dataset.blogDuplicate)];blogItems.unshift({...original,title:original.title+' — copie',status:'draft'});write(STORE_BLOG,blogItems);renderBlog();}));
  $$('[data-blog-delete]').forEach(b=>b.addEventListener('click',()=>{blogItems.splice(Number(b.dataset.blogDelete),1);write(STORE_BLOG,blogItems);renderBlog();}));
}
$('#blog-filter')?.addEventListener('change',renderBlog);
function updateRoadbookPdfPreview(){
  const url=$('#roadbook-pdf')?.value.trim()||'';
  const preview=$('#roadbook-pdf-preview');
  const link=$('#roadbook-pdf-link');
  if(!preview||!link) return;
  preview.hidden=!url;
  if(url) link.href=url;
}
$('#roadbook-pdf')?.addEventListener('input',updateRoadbookPdfPreview);

function renderRoadbooks(){
  const list=$('#roadbook-list');
  if(!roadbookItems.length){list.innerHTML='<div class="empty">Aucun roadbook créé dans cette maquette pour le moment.</div>';return;}
  list.innerHTML=roadbookItems.map((x,i)=>`<article class="item"><div class="item-top"><div><h3>${esc(x.title)}</h3><p class="meta">${esc(x.duration||'?')} jours · ${esc(x.transport||'transport à préciser')} · ${esc(x.price||'—')} € · ${x.pdf?'PDF ajouté':'PDF à ajouter'}</p></div><span class="pill">${x.status==='published'?'Visible':'Masqué'}</span></div><p>${esc(x.summary)}</p><div class="item-actions"><button data-roadbook-edit="${i}">Modifier</button>${x.pdf?`<a class="secondary" href="${esc(x.pdf)}" target="_blank" rel="noopener">Ouvrir le PDF</a>`:''}<button data-roadbook-delete="${i}">Supprimer</button></div></article>`).join('');
  $$('[data-roadbook-edit]').forEach(b=>b.addEventListener('click',()=>openForm('roadbook',Number(b.dataset.roadbookEdit))));
  $$('[data-roadbook-delete]').forEach(b=>b.addEventListener('click',()=>{roadbookItems.splice(Number(b.dataset.roadbookDelete),1);write(STORE_ROADBOOKS,roadbookItems);renderRoadbooks();}));
}
$('#save-blog').addEventListener('click',()=>{
  const item={
    title:$('#blog-title').value.trim(),
    category:$('#blog-category').value,
    summary:$('#blog-summary').value.trim(),
    date:$('#blog-date').value,
    status:$('#blog-status').value,
    html:$('#blog-editor').innerHTML.trim()
  };
  if(!item.title){alert('Ajoutez un titre.');return;}
  if(blogEdit===null) blogItems.unshift(item); else blogItems[blogEdit]=item;
  write(STORE_BLOG,blogItems);
  $('#blog-form').hidden=true;
  renderBlog();
});
$('#save-roadbook').addEventListener('click',()=>{
  const item={title:$('#roadbook-title').value.trim(),duration:$('#roadbook-duration').value,transport:$('#roadbook-transport').value.trim(),price:$('#roadbook-price').value,summary:$('#roadbook-summary').value.trim(),pdf:$('#roadbook-pdf').value.trim(),status:$('#roadbook-status').value};
  if(!item.title){alert('Ajoutez une destination ou un titre.');return;} if(roadbookEdit===null) roadbookItems.unshift(item); else roadbookItems[roadbookEdit]=item;
  write(STORE_ROADBOOKS,roadbookItems); $('#roadbook-form').hidden=true; renderRoadbooks();
});
window.addEventListener('message',(event)=>{
  if(event.origin!==window.location.origin || event.data?.type!=='routes-curieuses-sur-mesure-resize') return;
  const frame=$('#sur-mesure-frame');
  const height=Number(event.data.height);
  if(frame && Number.isFinite(height) && height>300) frame.style.height=Math.min(Math.max(height+8,900),4200)+'px';
});
const initialBlogItems = [{"title":"Carnet de voyage fictif — Quelques jours au bord des lacs","category":"Récits de voyage","date":"2026-11-23","status":"published","summary":"Un long récit de démonstration, entre chemins de montagne, villages tranquilles, imprévus et petits instants de voyage.","blocks":[{"type":"text","text":"Ce carnet est entièrement fictif : les lieux, les scènes et les impressions sont inventés pour tester la présentation du blog."},{"type":"heading","text":"Le plaisir de partir sans trop prévoir"},{"type":"text","text":"Il y a toujours un moment particulier au début d'un voyage. Celui où l'on ferme la porte derrière soi et où le quotidien change de rythme."},{"type":"image","url":"https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=1400&q=85","caption":"Première image d'ambiance : une pause au bord de l'eau."},{"type":"heading","text":"Un lac, une lumière et beaucoup de silence"},{"type":"text","text":"Le lendemain, je suis partie tôt, avant que les chemins ne se remplissent. L'air était frais et le paysage s'est ouvert sur un lac calme."},{"type":"image","url":"https://images.unsplash.com/photo-1477959858617-67f85cf4f1df?auto=format&fit=crop&w=1400&q=85","caption":"Une deuxième photographie pour tester l'alternance entre récit et images."}]},{"title":"Bienvenue sur le carnet","category":"Récits de voyage","date":"2026-11-22","status":"published","summary":"Les premiers récits et conseils de voyage arrivent bientôt.","blocks":[{"type":"text","text":"Bienvenue sur le carnet des Routes Curieuses !"},{"type":"text","text":"Ici, je partagerai mes récits de voyage, mes découvertes et mes conseils pour partir à l'aventure sans dépenser une fortune."},{"type":"text","text":"À très bientôt sur les routes !"}]}];
blogItems=read(STORE_BLOG,initialBlogItems);
roadbookItems=read(STORE_ROADBOOKS,[]);
renderBlog();renderRoadbooks();
</script>
</body>
</html>