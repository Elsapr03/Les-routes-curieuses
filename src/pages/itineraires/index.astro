---
import SiteHeader from '../../components/SiteHeader.astro';
import { getCollection } from 'astro:content';
const destinations = (await getCollection('destinations', ({ data }) => data.published)).sort((a,b)=>a.data.title.localeCompare(b.data.title,'fr'));
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="Découvrez les itinéraires et roadbooks des Routes Curieuses."/><title>Itinéraires — Les Routes Curieuses</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet"/><style>
:root{--cream:#faf8f2;--paper:#fffdf8;--ink:#263d52;--muted:#63727a;--terra:#b96f4d;--line:#dddcd4}*{box-sizing:border-box}body{margin:0;background:var(--cream);color:var(--ink);font-family:'DM Sans',sans-serif;line-height:1.65}a{color:inherit}h1,h2{font-family:'DM Serif Display',Georgia,serif;font-weight:400;line-height:1.15}.wrap{width:min(1120px,calc(100% - 40px));margin:auto}.topbar{background:var(--ink);color:white;text-align:center;font-size:.72rem;letter-spacing:.13em;padding:9px}.nav{min-height:90px;display:flex;justify-content:space-between;align-items:center;gap:20px}.logo{text-decoration:none;font:1.5rem 'DM Serif Display',Georgia,serif;line-height:1}.logo small{display:block;font:600 .56rem 'DM Sans',sans-serif;text-transform:uppercase;letter-spacing:.25em;margin-top:9px}.navlinks{display:flex;gap:24px;font-size:.85rem;font-weight:700}.navlinks a{text-decoration:none}.eyebrow{font-size:.72rem;text-transform:uppercase;letter-spacing:.2em;color:var(--terra);font-weight:700}.intro{padding:75px 0 45px}.intro h1{font-size:clamp(3rem,7vw,6rem);margin:12px 0 20px}.intro>p:last-child{max-width:670px;color:var(--muted);font-size:1.1rem}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px;padding:15px 0 100px}.card{background:var(--paper);border:1px solid var(--line);overflow:hidden}.card img,.photo-placeholder{width:100%;height:285px;object-fit:cover}.photo-placeholder{background:#dce5d6;display:grid;place-items:center;color:var(--ink);padding:30px;text-align:center}.content{padding:28px}.content h2{font-size:2.3rem;margin:8px 0}.content p{color:var(--muted)}.meta{font-size:.84rem;font-weight:700}.link{font-size:.9rem;font-weight:700;text-decoration:none;border-bottom:1px solid var(--terra);padding-bottom:4px}.empty{background:var(--paper);border:1px solid var(--line);padding:35px;margin-bottom:80px}footer{background:var(--ink);color:white;padding:35px 0;font-size:.8rem}
@media(max-width:650px){.nav{flex-wrap:wrap;padding:20px 0}.navlinks{gap:14px;flex-wrap:wrap}.intro{padding:50px 0 30px}.grid{grid-template-columns:1fr;padding-bottom:60px}.card img,.photo-placeholder{height:220px}}
</style></head><body><div class="topbar">VOYAGER LOIN · DÉPENSER MOINS · RESTER LIBRE</div><SiteHeader current="itineraires" /><main class="wrap"><section class="intro"><p class="eyebrow">Les carnets de route</p><h1>Choisissez votre prochaine aventure.</h1><p>Des voyages à découvrir à votre rythme, avec des étapes détaillées, des idées de transport et des budgets indicatifs.</p></section>{destinations.length ? <div class="grid">{destinations.map(d=><article class="card">{d.data.cover ? <img src={d.data.cover} alt={`Paysage de ${d.data.title}`} loading="lazy"/> : <div class="photo-placeholder">Photographie à venir</div>}<div class="content"><p class="eyebrow">Itinéraire</p><h2>{d.data.title}</h2><p class="meta">{d.data.duration ? `${d.data.duration} jours` : 'Durée à préciser'}{d.data.transport ? ` · ${d.data.transport}` : ''}</p><p>{d.data.description}</p><p>{d.data.travelBudget !== undefined ? `Budget indicatif : ${d.data.travelBudget} €` : 'Budget à préciser'} · {d.data.roadbookPrice !== undefined ? `Roadbook : ${d.data.roadbookPrice} €` : 'Tarif à préciser'}</p><a class="link" href={`/itineraires/${d.id}/`}>Découvrir ce voyage →</a></div></article>)}</div> : <div class="empty"><h2>De nouvelles routes se préparent.</h2><p>Les premiers itinéraires seront bientôt disponibles ici.</p></div>}</main><footer><div class="wrap">© {new Date().getFullYear()} Les Routes Curieuses</div></footer></body></html>