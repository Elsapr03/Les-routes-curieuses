---
import SiteHeader from '../../components/SiteHeader.astro';
import { getCollection } from 'astro:content';
const published = await getCollection('destinations', ({ data }) => data.published);
const slovenie = published.find(d => d.id === 'slovenie');
const cards = [
  {name:'Slovénie', days:5, transport:'Train de jour + train de nuit', low:true, budget:260, slug:slovenie?.id, color:'#d8e8e5', note:'Entre Alpes juliennes et Ljubljana'},
  {name:'Bulgarie', days:null, transport:'À préciser', low:null, budget:null, slug:null, color:'#e9d8c2', note:'Itinéraire en préparation'},
  {name:'Monténégro', days:null, transport:'À préciser', low:null, budget:null, slug:null, color:'#d5e4e8', note:'Itinéraire en préparation'},
  {name:'Toscane', days:null, transport:'À préciser', low:null, budget:null, slug:null, color:'#f0dfc8', note:'Itinéraire en préparation'},
  {name:'Arménie', days:null, transport:'À préciser', low:null, budget:null, slug:null, color:'#e4dfd4', note:'Itinéraire en préparation'},
  {name:'Balkans', days:null, transport:'À préciser', low:null, budget:null, slug:null, color:'#dce5d9', note:'Itinéraire en préparation'},
  {name:'Vietnam', days:null, transport:'À préciser', low:null, budget:null, slug:null, color:'#d6e5e9', note:'Itinéraire en préparation'},
  {name:'Prochainement', days:null, transport:'', low:null, budget:null, slug:null, color:'#eee7dc', note:'Une nouvelle destination à venir'}
];
---
<!doctype html>
<html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="Découvrez les itinéraires préconçus des Routes Curieuses et préparez votre roadbook sur mesure."/><title>Itinéraires — Les Routes Curieuses</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700&family=Playfair+Display:wght@400;600&display=swap" rel="stylesheet"/>
<style>
:root{--cream:#faf6ef;--paper:#fffdf9;--ink:#082e3d;--muted:#64737a;--line:#e6dccc;--green:#295e47;--terra:#9d6634}*{box-sizing:border-box}body{margin:0;background:var(--cream);color:var(--ink);font-family:Raleway,Arial,sans-serif;line-height:1.55}a{color:inherit;text-decoration:none}button,select{font:inherit}h1,h2{font-family:'Playfair Display',Georgia,serif;font-weight:400}.wrap{width:min(1120px,calc(100% - 36px));margin:auto}.intro{padding:55px 0 20px}.intro h1{font-size:clamp(2.3rem,4vw,3.5rem);margin:0 0 12px}.intro p{font-size:.95rem;color:var(--muted);max-width:680px;margin:0}.filters{display:grid;grid-template-columns:repeat(4,minmax(0,1fr)) auto;align-items:end;gap:14px;background:white;border:1px solid var(--line);border-radius:12px;padding:18px;margin:20px 0 22px}.filters label{font-size:.76rem;font-weight:700}.filters select{display:block;width:100%;padding:10px 9px;border:1px solid #d5c8b6;border-radius:6px;background:white;color:var(--ink);margin-top:5px;font-size:.83rem}.check{display:flex;align-items:center;gap:7px;white-space:nowrap;padding-bottom:10px}.check input{accent-color:var(--green)}.count{color:var(--muted);font-size:.82rem;margin:0 0 12px}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;padding-bottom:70px}.card{border:1px solid var(--line);border-radius:11px;overflow:hidden;background:white;display:flex;flex-direction:column;min-height:275px}.card[hidden]{display:none}.card-top{height:148px;position:relative;display:flex;align-items:flex-end;padding:12px}.tag{background:var(--green);color:white;border-radius:20px;font-size:.69rem;padding:4px 9px;font-weight:700}.pending{background:#766e63}.card-body{padding:14px 15px 17px;display:flex;flex-direction:column;flex:1}.card h2{font-size:1.5rem;margin:0 0 5px}.meta{font-size:.75rem;color:var(--muted);margin:0 0 10px}.note{font-size:.77rem;color:var(--muted);margin:0 0 12px}.card-bottom{border-top:1px solid var(--line);padding-top:9px;margin-top:auto;font-size:.8rem}.card-bottom strong{display:block}.card-bottom a{color:var(--ink);text-decoration:underline;text-underline-offset:3px;font-weight:700}.card-bottom span{color:var(--muted)}.empty{display:none;padding:30px 0;color:var(--muted)}footer{background:var(--ink);color:white;padding:25px 0;font-size:.8rem}@media(max-width:950px){.grid{grid-template-columns:repeat(3,1fr)}.filters{grid-template-columns:repeat(2,1fr)}.check{padding:0}}@media(max-width:650px){.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.card-top{height:112px}.card h2{font-size:1.25rem}.card-body{padding:12px}.filters{grid-template-columns:1fr 1fr;gap:12px}.intro{padding-top:32px}}@media(max-width:390px){.grid{grid-template-columns:1fr}.filters{grid-template-columns:1fr}}
</style></head>
<body><SiteHeader current="itineraires"/><main class="wrap"><section class="intro"><h1>Les itinéraires</h1><p>Des voyages déjà conçus, avec un budget indicatif et un aperçu du parcours. Choisissez une destination, puis personnalisez votre carnet selon vos dates et vos envies.</p></section>
<form class="filters" id="filters" aria-label="Filtrer les itinéraires">
<label>Budget du voyage<select id="budget"><option value="all">Tous les budgets</option><option value="300">Jusqu'à 300 €</option><option value="600">Jusqu'à 600 €</option><option value="1000">Jusqu'à 1 000 €</option></select></label>
<label>Durée<select id="duration"><option value="all">Toutes les durées</option><option value="5">Jusqu'à 5 jours</option><option value="7">Jusqu'à 7 jours</option><option value="14">Jusqu'à 14 jours</option></select></label>
<label>Mois de départ<select id="month" disabled title="Les périodes conseillées seront ajoutées plus tard"><option value="all">À venir</option></select></label>
<label>Type de voyage<select id="type"><option value="all">Tous</option><option value="train">Train</option><option value="bus">Bus</option><option value="velo">Vélo</option></select></label>
<label class="check"><input id="low" type="checkbox"/> Bas carbone uniquement</label>
</form>
<p class="count" id="count" aria-live="polite">{cards.length} destinations, dont 1 fiche détaillée disponible</p>
<div class="grid" id="cards">{cards.map(c=><article class="card" data-days={c.days??''} data-budget={c.budget??''} data-transport={c.transport.toLowerCase()} data-low={c.low===true?'yes':'unknown'} data-ready={c.slug?'yes':'no'}><div class="card-top" style={`background:${c.color}`}><span class:list={['tag',{'pending':!c.slug}]}>{c.slug?'Bas carbone':'À venir'}</span></div><div class="card-body"><h2>{c.name}</h2><p class="meta">{c.days?`${c.days} jours · ${c.transport}`:'Détails en préparation'}</p><p class="note">{c.note}</p><div class="card-bottom">{c.slug?<><strong>Voyage dès {c.budget} €*</strong><a href={`/itineraires/${c.slug}/`}>Découvrir la fiche →</a></>:<span>Fiche bientôt disponible</span>}</div></div></article>)}</div><p id="empty" class="empty">Aucun itinéraire disponible avec ces critères. Essayez d'élargir votre recherche.</p><p style="font-size:.78rem;color:var(--muted);margin-top:-40px;margin-bottom:65px">* Estimation basse saison par personne, selon les conditions décrites dans la fiche. Les destinations « À venir » ne sont pas encore ouvertes.</p>
</main><footer><div class="wrap">© {new Date().getFullYear()} Les Routes Curieuses · <a href="/sur-mesure/">Créer mon carnet sur mesure</a></div></footer>
<script>
const form=document.getElementById('filters');
function filterCards(){
 const budget=document.getElementById('budget').value, duration=document.getElementById('duration').value, type=document.getElementById('type').value, low=document.getElementById('low').checked, month=document.getElementById('month').value;
 const items=[...document.querySelectorAll('#cards .card')];let visible=0;
 for(const item of items){
  const ready=item.dataset.ready==='yes';
  const okBudget=budget==='all'||(ready&&Number(item.dataset.budget)<=Number(budget));
  const okDuration=duration==='all'||(ready&&Number(item.dataset.days)<=Number(duration));
  const okType=type==='all'||(ready&&item.dataset.transport.includes(type));
  const okLow=!low||item.dataset.low==='yes';
  // Les mois de départ ne sont pas encore renseignés : ne pas promettre de disponibilité.
  const okMonth=month==='all';
  const show=okBudget&&okDuration&&okType&&okLow&&okMonth;item.hidden=!show;if(show)visible++;
 }
 document.getElementById('count').textContent=`${visible} destination${visible>1?'s':''} affichée${visible>1?'s':''}`;
 document.getElementById('empty').style.display=visible?'none':'block';
}
form.addEventListener('change',filterCards);
</script>
</body></html>