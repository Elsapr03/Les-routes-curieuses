---
import SiteHeader from '../../components/SiteHeader.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
 const items = await getCollection('destinations', ({data}) => data.published);
 return items.map(item=>({params:{slug:item.id},props:{item}}));
}
const {item}=Astro.props;
const {Content}=await render(item);
const d=item.data;
const isSlovenia=item.id==='slovenie';
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={d.description}/><title>{d.title} — Les Routes Curieuses</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700&family=Playfair+Display:wght@400;600&display=swap" rel="stylesheet"/>
<style>
:root{--cream:#faf6ef;--paper:#fffdf9;--ink:#082e3d;--muted:#5c6e72;--blue:#497e9e;--line:#e4d9cb}*{box-sizing:border-box}body{margin:0;background:var(--cream);color:var(--ink);font-family:Raleway,Arial,sans-serif;line-height:1.7}a{color:inherit}h1,h2,h3{font-family:'Playfair Display',Georgia,serif;font-weight:400;line-height:1.2}.wrap{width:min(1100px,calc(100% - 36px));margin:auto}.back{display:inline-block;margin:28px 0;text-decoration:none;font-size:.85rem;font-weight:700}.hero{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(240px,1fr);gap:22px;align-items:stretch}.hero-copy{background:var(--blue);color:white;border-radius:34px;padding:42px}.eyebrow{font-size:.78rem;text-transform:uppercase;letter-spacing:.13em;font-weight:700}.hero h1{font-size:clamp(2.7rem,5vw,4.6rem);margin:8px 0 12px}.hero .lead{font-size:1rem}.facts{display:flex;gap:15px;flex-wrap:wrap;margin:20px 0;font-weight:700;font-size:.88rem}.price{font-size:1.05rem;font-weight:700}.small{font-size:.75rem}.hero-photo{border-radius:24px;background:#d7e5df;min-height:340px;overflow:hidden}.hero-photo img{height:100%;width:100%;object-fit:cover}.photo-placeholder{height:100%;display:grid;place-items:center;padding:30px;text-align:center}.notice{font-size:.79rem;color:var(--muted);margin:14px 0 55px}.body-grid{display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:55px;margin-bottom:70px}.prose{font-size:1rem}.prose h2{font-size:2.1rem;margin:34px 0 15px}.prose h3{font-size:1.45rem;margin:20px 0 8px}.prose p{margin-top:0}.prose h2:nth-of-type(2){border-top:1px solid var(--line);padding-top:28px}.aside{align-self:start;position:sticky;top:22px;background:#e7f0f0;border:1px solid #ccdddd;border-radius:20px;padding:24px}.aside h2{font-size:1.9rem;margin:0 0 12px}.aside p,.aside li{font-size:.86rem}.aside ul{padding-left:18px}.button{display:inline-block;text-align:center;background:var(--ink);color:white;text-decoration:none;padding:13px 20px;border-radius:25px;font-weight:700;font-size:.85rem}.aside .button{width:100%;margin-top:10px}.fine{font-size:.75rem;color:var(--muted)}footer{background:var(--ink);color:white;padding:30px 0;font-size:.8rem}@media(max-width:760px){.hero{grid-template-columns:1fr}.hero-copy{padding:26px;border-radius:24px}.hero-photo{min-height:220px;max-height:320px}.body-grid{grid-template-columns:1fr;gap:15px}.aside{position:static}.notice{margin-bottom:30px}}
</style></head><body><SiteHeader current="itineraires"/><main class="wrap"><a class="back" href="/itineraires/">← Tous les itinéraires</a><section class="hero"><div class="hero-copy"><p class="eyebrow">{isSlovenia?"L'Europe verte, entre Alpes et Adriatique":'Itinéraire préconçu'}</p><h1>{d.title}</h1><div class="facts"><span>◷ {d.duration?d.duration+' jours':'Durée à préciser'}</span><span>🚆 {d.transport||'Transport à préciser'}</span>{isSlovenia&&<span>♧ Voyage bas carbone</span>}</div><p class="lead">{d.description}</p><p class="price">{d.travelBudget!==undefined?`Voyage à partir de ${d.travelBudget} €* par personne`:'Budget à préciser'}{d.roadbookPrice!==undefined&&` + ${d.roadbookPrice} € de création de carnet`}</p><a class="button" style="background:white;color:#082e3d" href="#parcours">Découvrir l'itinéraire ↓</a></div><div class="hero-photo">{d.cover?<img src={d.cover} alt={`Paysage de ${d.title}`}/>:<div class="photo-placeholder">Photographie de {d.title} à ajouter</div>}</div></section>
<p class="notice">* Pour la Slovénie : estimation basse saison au départ de Paris, comprenant le transport, les couchettes partagées en train de nuit et un hébergement en auberge, selon la fiche produit fournie. Prix indicatifs, susceptibles d'évoluer ; aucune réservation n'est incluse.</p>
<div class="body-grid"><article id="parcours" class="prose"><Content/></article><aside class="aside"><p class="eyebrow">Comment préparer ce voyage ?</p><h2>Votre carnet sur mesure</h2><p>Un itinéraire pensé pour vos dates, votre budget et vos envies. Vous restez libre d'effectuer toutes vos réservations.</p><p><strong>{d.roadbookPrice!==undefined?`À partir de ${d.roadbookPrice} €`:'Tarif à confirmer'}</strong></p><ul><li>Itinéraire personnalisé</li><li>Hébergements et adresses sélectionnés</li><li>Conseils pratiques</li><li>Carnet PDF complet, prêt à l'emploi</li></ul><a class="button" href="/sur-mesure/">Créer mon carnet sur mesure →</a><p class="fine">Demande de carnet : les modalités et disponibilités seront confirmées avant toute commande.</p></aside></div></main><footer><div class="wrap">© {new Date().getFullYear()} Les Routes Curieuses · <a href="/itineraires/">Itinéraires</a></div></footer></body></html>