---
import SiteHeader from '../components/SiteHeader.astro';
import { getCollection } from 'astro:content';
const destinations = (await getCollection('destinations', ({ data }) => data.published)).sort((a,b)=>a.data.title.localeCompare(b.data.title,'fr')).slice(0,4);
const articles = (await getCollection('blog', ({ data }) => data.published)).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime()).slice(0,3);
const steps = [
  { number:'01', title:'Choisissez votre route', text:'Un itinéraire existant, ou un roadbook imaginé pour vous.' },
  { number:'02', title:'Préparons votre départ', text:'Pour un roadbook prêt à télécharger, consultez le contenu et le prix. Pour le sur-mesure, échangeons sur votre projet.' },
  { number:'03', title:'Partez à votre rythme', text:'Recevez votre roadbook en PDF et effectuez vous-même vos réservations.' }
];
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Les Routes Curieuses : itinéraires à petit budget et roadbooks sur mesure pour voyager librement." />
  <title>Les Routes Curieuses — Des voyages qui vous ressemblent</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700&family=Playfair+Display:ital@0;1&display=swap" rel="stylesheet" />
  <style>
    :root{--cream:#FAF6EF;--paper:#FAF6EF;--ink:#082E3D;--muted:#5C6E72;--terra:#B9793C;--sage:#E7DECF;--line:#E9DFCF}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font-family:'Raleway',Arial,sans-serif;line-height:1.65}a{color:inherit;text-decoration:none}a:focus-visible,button:focus-visible{outline:3px solid var(--terra);outline-offset:4px}img{max-width:100%;display:block}h1,h2,h3,p{margin-top:0}h1,h2,h3{font-family:'Playfair Display',Georgia,serif;font-weight:400;line-height:1.12}h1{font-size:clamp(2.7rem,5.5vw,5.3rem);letter-spacing:-.035em}h2{font-size:clamp(2.2rem,4vw,4.2rem);letter-spacing:-.025em}h3{font-size:clamp(1.65rem,2.4vw,2.5rem)}.wrap{width:min(1180px,calc(100% - 44px));margin:auto}.eyebrow{font-size:.72rem;text-transform:uppercase;letter-spacing:.19em;font-weight:700;color:var(--terra)}.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 23px;background:var(--ink);color:white;border:1px solid var(--ink);border-radius:3px;font-weight:700;font-size:.88rem;transition:transform .2s,background .2s}.button:hover{background:#1F4347;transform:translateY(-2px)}.button.secondary{background:transparent;color:var(--ink)}.button.secondary:hover{background:white}.button.light{background:var(--paper);color:var(--ink);border-color:var(--paper)}.text-link{font-weight:700;border-bottom:1px solid currentColor;padding-bottom:3px}.topbar{background:var(--ink);color:#fff;text-align:center;font-size:.72rem;letter-spacing:.12em;padding:8px 15px}.nav{height:88px;display:flex;justify-content:space-between;align-items:center;gap:25px}.logo{font-family:'Playfair Display',Georgia,serif;font-size:1.6rem;line-height:1;max-width:205px}.logo span{display:block;font-family:'Raleway',sans-serif;font-size:.57rem;letter-spacing:.29em;text-transform:uppercase;margin-top:8px}.nav-links{display:flex;align-items:center;gap:23px;font-size:.81rem;font-weight:700}.nav-links a:hover{color:var(--terra)}.nav-cta{padding:10px 15px;border:1px solid var(--ink)}.hero{position:relative;min-height:440px;display:flex;align-items:center;isolation:isolate;background:#536d6e;color:#fff;overflow:hidden}.hero::before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(15,32,43,.86),rgba(15,32,43,.52) 48%,rgba(15,32,43,.14)),url('https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=2000&q=85') center/cover;z-index:-1}.hero-inner{padding:60px 0;max-width:1180px}.hero-copy{max-width:720px}.hero .eyebrow{color:#f0c1a4}.hero p.lead{font-size:clamp(1rem,1.6vw,1.3rem);max-width:610px;margin-bottom:30px;color:#f3f0e9}.actions{display:flex;gap:12px;flex-wrap:wrap}.hero .button.secondary{color:white;border-color:rgba(255,255,255,.8)}.hero .button.secondary:hover{background:rgba(255,255,255,.15)}.hero-caption{position:absolute;right:25px;bottom:15px;font-size:.66rem;color:#e5e8e5}.section{padding:100px 0}.section-head{max-width:760px;margin-bottom:40px}.section-head p:not(.eyebrow){color:var(--muted);font-size:1.07rem}.intro{background:var(--paper);padding:40px 0;border-bottom:1px solid var(--line)}.intro-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:25px}.intro-item{border-left:2px solid var(--terra);padding-left:18px}.intro-item strong{display:block;font-size:.89rem}.intro-item span{font-size:.78rem;color:var(--muted)}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:25px;align-items:stretch}.offer{background:var(--paper);border:1px solid var(--line);overflow:hidden;display:flex;flex-direction:column}.offer img{width:100%;height:300px;object-fit:cover}.offer-body{padding:33px;flex:1}.offer-body p{color:var(--muted)}.offer .eyebrow{margin-bottom:10px}.offer .text-link{display:inline-block;margin-top:10px}.destination-grid{display:grid;grid-template-columns:1fr 1fr;gap:26px}.destination-grid:has(> :only-child){grid-template-columns:minmax(0,1fr)}.destination-grid:has(> :only-child) .destination{display:grid;grid-template-columns:1fr 1fr;align-items:stretch}.destination-grid:has(> :only-child) .destination img,.destination-grid:has(> :only-child) .destination-photo-placeholder{height:100%;min-height:330px}.destination{background:var(--paper);border:1px solid var(--line)}.destination img,.destination-photo-placeholder{width:100%;height:300px;object-fit:cover}.destination-photo-placeholder{display:grid;place-items:center;background:var(--sage);padding:25px;text-align:center;color:var(--ink)}.destination-body{padding:26px}.destination-body h3{margin-bottom:7px}.meta{font-size:.8rem;color:var(--muted)}.note{font-size:.76rem;color:var(--muted);margin-bottom:0}.destination .text-link{display:inline-block;margin:15px 0}.book{background:var(--sage)}.book-grid{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:70px}.book-visual{background:var(--paper);padding:25px;transform:rotate(-2deg);box-shadow:12px 18px 0 rgba(38,61,82,.11)}.sample{background:#f5f0e6;border:1px solid #e2d9c9;min-height:350px;padding:32px}.sample-head{font-size:.65rem;letter-spacing:.18em;text-transform:uppercase;border-bottom:1px solid #c6bbaa;padding-bottom:12px}.sample h3{margin:28px 0 12px}.sample .sample-row{padding:12px 0;border-top:1px solid #d6cbbb;display:flex;justify-content:space-between;gap:15px;font-size:.8rem}.sample-tag{display:inline-block;background:var(--sage);padding:3px 10px;font-size:.7rem}.book-copy p:not(.eyebrow){color:#40545c}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:35px}.step{border-top:1px solid var(--ink);padding-top:20px}.step-num{font-family:'Playfair Display',Georgia,serif;font-size:3.5rem;color:var(--terra)}.step h3{font-size:1.7rem}.step p{color:var(--muted)}.split{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}.split img{height:430px;width:100%;object-fit:cover}.split p{color:var(--muted)}.trust{background:var(--ink);color:white}.trust h2{max-width:760px}.trust-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;margin-top:45px}.trust-item{border-top:1px solid rgba(255,255,255,.45);padding-top:20px}.trust-item p{color:#d3dce0;font-size:.89rem}.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.blog-card{border-top:2px solid var(--terra);padding-top:18px}.blog-card h3{font-size:1.6rem}.newsletter{background:#E7DECF;padding:65px 0;text-align:center}.newsletter p{color:var(--muted)}footer{background:#082E3D;color:#e8eeed;padding:65px 0 25px}footer .footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:40px}footer .logo{color:#fff}footer p{font-size:.85rem;color:#b9c6cc;max-width:290px}footer a{display:block;font-size:.82rem;margin-bottom:10px}footer .footnote{margin-top:50px;padding-top:20px;border-top:1px solid #5C6E72;font-size:.75rem;color:#b9c6cc}.placeholder{font-size:.73rem;color:var(--muted);font-style:italic}.tag{display:inline-block;background:var(--sage);color:var(--ink);font-size:.72rem;font-weight:700;padding:5px 9px;margin-bottom:10px}
    .offer-body{display:flex;flex-direction:column;align-items:flex-start;min-height:350px;height:100%}.offer-body .offer-label{display:inline-block;background:var(--sage);padding:5px 10px;font-size:.74rem;font-weight:700;margin:0 0 16px;color:var(--ink)}.offer-body h3{font-size:clamp(1.9rem,2.7vw,2.65rem);margin-bottom:15px}.offer-body .offer-action{margin-top:auto;padding-top:18px;width:100%}.offer-body .offer-action .button{min-height:48px}.offer-body .offer-note{font-size:.78rem;color:var(--muted);margin:12px 0 0;min-height:2.5em}.offer-body .offer-description{font-size:.96rem}
    .offers-heading{max-width:850px;margin:0 auto 42px;text-align:center}.offers-heading p:not(.eyebrow){margin-left:auto;margin-right:auto;max-width:680px}
    @media(max-width:850px){.nav{height:auto;padding:20px 0;align-items:flex-start;flex-wrap:wrap}.nav-links{flex-wrap:wrap;gap:12px}.nav-cta{display:none}.intro-grid{grid-template-columns:1fr 1fr}.book-grid,.split{gap:30px}.section{padding:75px 0}.trust-grid{gap:18px}}
    @media(max-width:620px){.destination-grid:has(> :only-child) .destination{display:block}.destination-grid:has(> :only-child) .destination img,.destination-grid:has(> :only-child) .destination-photo-placeholder{height:220px;min-height:0}}
    @media(max-width:620px){.wrap{width:min(100% - 32px,1180px)}.nav{gap:15px}.logo{font-size:1.4rem}.nav-links{font-size:.72rem;gap:11px}.hero{min-height:420px}.hero-inner{padding:48px 0}.hero::before{background:linear-gradient(90deg,rgba(15,32,43,.86),rgba(15,32,43,.48)),url('https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=900&q=80') center/cover}.intro-grid,.two-col,.destination-grid,.book-grid,.steps,.split,.trust-grid,.blog-grid,footer .footer-grid{grid-template-columns:1fr}.intro-grid{gap:20px}.offer img,.destination img,.destination-photo-placeholder{height:220px}.book-visual{transform:none}.sample{min-height:290px}.split img{height:270px}.section{padding:65px 0}.section-head{margin-bottom:25px}.newsletter{padding:55px 0}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.button{transition:none}}
  </style>
</head>
<body>
  <div class="topbar">VOYAGER LOIN · DÉPENSER MOINS · RESTER LIBRE</div>
  <SiteHeader current="" />
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero-inner"><div class="hero-copy">
        <p class="eyebrow">Des roadbooks pour les voyageurs curieux</p>
        <h1 id="hero-title">Voyager loin, sans dépenser une fortune.</h1>
        <p class="lead">Des itinéraires inspirants, pensés jusque dans les détails, et des roadbooks sur mesure construits à partir de vos envies. Vous partez avec tout en main et vous réservez vous-même.</p>
        <div class="actions"><a class="button light" href="#itineraires">Découvrir les itinéraires</a><a class="button secondary" href="/sur-mesure/">Créer mon roadbook</a></div>
      </div></div><span class="hero-caption">Photographie d'ambiance provisoire</span>
    </section>
    <section class="intro" aria-label="Les engagements"><div class="wrap intro-grid">
      <div class="intro-item"><strong>Petit budget</strong><span>Des dépenses estimées pour préparer votre départ.</span></div>
      <div class="intro-item"><strong>Prêts à partir</strong><span>Des itinéraires déjà conçus, à adapter à vos dates.</span></div>
      <div class="intro-item"><strong>Sur mesure</strong><span>Vos inspirations rencontrent les miennes.</span></div>
      <div class="intro-item"><strong>Bas carbone, en option</strong><span>Train, bus, bateau et vélo à l'honneur.</span></div>
    </div></section>
    <section class="section wrap" id="offres">
      <div class="section-head offers-heading"><p class="eyebrow">Nos deux offres</p><h2>Un roadbook prêt à télécharger ou créé sur mesure ?</h2><p>Dans les deux cas, vous recevez un ebook pour préparer votre voyage en toute autonomie : un itinéraire déjà conçu ou un roadbook personnalisé selon vos envies.</p></div>
      <div class="two-col">
        <article class="offer"><img loading="lazy" src="https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=1100&q=85" alt="Lac et montagnes, inspiration pour un roadbook numérique" /><div class="offer-body"><span class="offer-label">OFFRE 1 · GUIDE NUMÉRIQUE</span><h3>Un roadbook à télécharger</h3><p class="offer-description">Vous choisissez une destination et achetez un itinéraire déjà imaginé. Vous recevez un guide PDF pour préparer votre voyage en toute liberté.</p><div class="offer-action"><a class="button" href="/roadbooks/slovenie/">Voir le roadbook Slovénie</a><p class="offer-note">Premier roadbook en préparation · Achat bientôt disponible</p></div></div></article>
        <article class="offer" id="sur-mesure"><img loading="lazy" src="https://images.unsplash.com/photo-1455390582262-044cdead277a?auto=format&fit=crop&w=1100&q=85" alt="Carnet ouvert pour préparer un voyage personnalisé" /><div class="offer-body"><span class="offer-label">OFFRE 2 · ACCOMPAGNEMENT PERSONNALISÉ</span><h3>Un voyage imaginé pour vous</h3><p class="offer-description">Vous me racontez vos envies, votre budget et vos contraintes. Je crée pour vous un ebook personnalisé avec un itinéraire adapté à votre voyage. Aucun logement, transport ou activité n'est réservé : vous effectuez vous-même toutes vos réservations.</p><div class="offer-action"><a class="button secondary" href="/sur-mesure/">Découvrir l'accompagnement</a><p class="offer-note">Création de l'ebook sur mesure · Demandes bientôt ouvertes</p></div></div></article>
      </div>
    </section>
    <section class="section book" id="itineraires">
      <div class="wrap book-grid">
        <div class="book-visual" aria-label="Maquette illustrative d'un carnet de route">
          <div class="sample"><div class="sample-head">Les Routes Curieuses · Exemple de mise en page</div><h3>Votre carnet de route</h3><p>Une journée à la fois, toutes les informations au même endroit.</p><span class="sample-tag">Aperçu de principe — non contractuel</span><div style="margin-top:35px"><div class="sample-row"><span>Étapes & découvertes</span><span>01</span></div><div class="sample-row"><span>Transports & trajets</span><span>02</span></div><div class="sample-row"><span>Budget & conseils</span><span>03</span></div></div></div>
        </div>
        <div class="book-copy"><p class="eyebrow">Premier roadbook numérique</p><h2>La Slovénie, pour commencer l'aventure.</h2><p>Un premier itinéraire déjà imaginé, à découvrir dans un guide numérique. Cette maquette donne un aperçu de l'esprit du carnet : le véritable extrait sera ajouté dès que nous aurons le PDF.</p><p><strong>Prix et achat en ligne à venir.</strong> Vous gardez la liberté d'organiser vos réservations.</p><a class="button" href="/roadbooks/slovenie/">Découvrir le roadbook Slovénie</a></div>
      </div>
    </section>
    <section class="section wrap" id="fonctionnement"><div class="section-head"><p class="eyebrow">Simple et libre</p><h2>Comment ça marche ?</h2></div><div class="steps">{steps.map((step)=><div class="step"><div class="step-num">{step.number}</div><h3>{step.title}</h3><p>{step.text}</p></div>)}</div></section>
    <section class="section wrap" id="bas-carbone"><div class="split"><img loading="lazy" src="https://images.unsplash.com/photo-1473448912268-2022ce9509d8?auto=format&fit=crop&w=1000&q=85" alt="Chemin dans une forêt verdoyante" /><div><p class="eyebrow">Des façons de voyager plus douces</p><h2>Envie de voyager autrement ?</h2><p>Train, bus, bateau ou vélo : certains itinéraires mettent à l'honneur des transports moins carbonés. À chacun de choisir selon ses envies et ses contraintes, sans injonction.</p><a class="text-link" href="/itineraires/">Découvrir les routes</a></div></div></section>
    <section class="section trust"><div class="wrap"><p class="eyebrow">Avant de vous lancer</p><h2>Un roadbook pour préparer, pas une réservation de voyage.</h2><div class="trust-grid"><div class="trust-item"><h3>Vous restez libre</h3><p>Vous réservez vous-même vos transports, hébergements et activités.</p></div><div class="trust-item"><h3>Des budgets indicatifs</h3><p>Les prix et disponibilités peuvent évoluer selon les dates et les prestataires.</p></div><div class="trust-item"><h3>Une commande expliquée</h3><p>Le contenu exact du PDF, son tarif et son délai d'envoi seront affichés avant l'ouverture des ventes.</p></div></div></div></section>
    <section class="section wrap" id="a-propos"><div class="split"><div><p class="eyebrow">Derrière Les Routes Curieuses</p><h2>Une voyageuse, mille façons de prendre la route.</h2><p>J'ai parcouru l'Europe et au-delà en train, en bus, en bateau, souvent seule. Ces voyages m'ont appris qu'on peut partir loin avec peu, à condition d'être bien préparé.</p><p class="placeholder">Portrait personnel à ajouter avec l'accord de la créatrice.</p></div><img loading="lazy" src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1000&q=85" alt="Paysage montagneux évoquant l'envie de voyage" /></div></section>
    <section class="section wrap" id="blog"><div class="section-head"><p class="eyebrow">Le carnet</p><h2>Sur le blog</h2></div>{articles.length ? <div class="blog-grid">{articles.map(article => <article class="blog-card"><p class="eyebrow">{article.data.category || 'Carnet de voyage'}</p><h3><a href={`/blog/${article.id}/`}>{article.data.title}</a></h3><p>{article.data.description}</p><a class="text-link" href={`/blog/${article.id}/`}>Lire l'article →</a></article>)}</div> : <p>Les premiers articles arrivent bientôt.</p>}<p style="margin-top:30px"><a class="text-link" href="/blog/">Tous les articles du blog →</a></p></section>
    <section class="newsletter"><div class="wrap"><p class="eyebrow">Un peu de curiosité dans votre boîte mail</p><h2>Un guide gratuit se prépare.</h2><p>10 conseils pour préparer un voyage simple, libre et à petit budget.</p><p class="placeholder">L'inscription sera proposée lorsque le guide et son envoi seront disponibles.</p></div></section>
  </main>
  <footer id="informations-contact"><div class="wrap"><div class="footer-grid"><div><a class="logo" href="/">Les Routes Curieuses<span>Roadbooks & itinéraires</span></a><p>Des roadbooks pour voyager loin avec un petit budget.</p></div><div><strong>Explorer</strong><a href="#itineraires">Itinéraires</a><a href="#sur-mesure">Sur mesure</a><a href="#bas-carbone">Bas carbone</a></div><div><strong>Découvrir</strong><a href="/blog/">Blog</a><a href="/a-propos/">À propos</a><a href="/contact/">Contact</a></div></div><div class="footnote">© {new Date().getFullYear()} Les Routes Curieuses · <a href="/mentions-legales/">Mentions légales</a> · Maquette de test — informations commerciales à compléter avant publication.</div></div></footer>
</body>
</html>
