---
import SiteHeader from '../../components/SiteHeader.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){
  const articles = await getCollection('blog', ({ data }) => data.published);
  return articles.map(article=>({params:{slug:article.id},props:{article}}));
}
const { article } = Astro.props;
const { Content } = await render(article);
const dateFr = article.data.date.toLocaleDateString('fr-FR',{day:'numeric',month:'long',year:'numeric'});
---
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="robots" content="noindex,nofollow"/>
<meta name="description" content={article.data.description}/>
<title>{article.data.title} — Les Routes Curieuses</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Raleway:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<style>
:root{--cream:#FAF6EF;--ink:#082E3D;--muted:#5C6E72;--sand:#E7DECF;--ochre:#B9793C}
*{box-sizing:border-box}body{margin:0;background:var(--cream);color:var(--ink);font:16px/1.85 Raleway,Arial,sans-serif}a{color:inherit}a:focus-visible{outline:3px solid var(--ochre);outline-offset:4px}.wrap{width:min(1100px,calc(100% - 48px));margin-inline:auto}
header{border-bottom:1px solid var(--sand)}.nav{min-height:84px;display:flex;justify-content:space-between;align-items:center;gap:24px}.brand{font:600 1.5rem 'Playfair Display',Georgia,serif;text-decoration:none}.links{display:flex;flex-wrap:wrap;gap:24px;font-size:.87rem;font-weight:600}.links a{text-decoration:none}
.article-head{max-width:820px;margin:0 auto;text-align:center;padding:76px 24px 48px}.back{font-size:.83rem;text-decoration:none;color:var(--muted)}.eyebrow{margin:33px 0 14px;text-transform:uppercase;letter-spacing:.17em;color:var(--ochre);font-size:.74rem;font-weight:700}h1,h2,h3{font-family:'Playfair Display',Georgia,serif;line-height:1.18}h1{font-size:clamp(2.8rem,6.2vw,5.3rem);font-weight:600;margin:0 0 22px}.description{max-width:620px;margin:0 auto;font-size:1.07rem;color:var(--muted)}.date{margin:20px 0 0;font-size:.79rem;color:var(--muted)}.cover{display:block;width:min(1100px,calc(100% - 48px));max-height:570px;object-fit:cover;margin:0 auto 54px;border-radius:5px}
.story{max-width:730px;margin:0 auto;padding:0 24px 80px;font-size:1.04rem;line-height:2}.story :global(p){margin:0 0 1.65em}.story :global(h2){font-size:clamp(1.8rem,4vw,2.5rem);margin:2em 0 .65em}.story :global(h3){font-size:1.55rem;margin:1.8em 0 .5em}.story :global(img){display:block;max-width:100%;height:auto;margin:36px auto 12px;border-radius:4px}.story :global(figure){margin:40px 0}.story :global(figcaption){font-size:.78rem;text-align:center;color:var(--muted)}.story :global(blockquote){margin:42px 0;padding:10px 0 10px 27px;border-left:3px solid var(--ochre);font:italic 1.35rem/1.6 'Playfair Display',Georgia,serif}.story :global(a){text-decoration-color:var(--ochre);text-underline-offset:4px}.story :global(ul),.story :global(ol){padding-left:25px;margin-bottom:26px}.story :global(hr){border:0;border-top:1px solid var(--sand);margin:50px 0}
.end{max-width:730px;margin:0 auto 80px;padding:30px 24px 0;border-top:1px solid var(--sand)}.end a{font-size:.9rem;font-weight:700;text-decoration:none}.end a:hover{color:var(--ochre)}footer{border-top:1px solid var(--sand);padding:27px 0;color:var(--muted);font-size:.83rem}.footer-links{display:flex;gap:22px;flex-wrap:wrap}
@media(max-width:680px){.nav{align-items:flex-start;flex-direction:column;padding:18px 0}.links{gap:15px}.article-head{padding-top:52px}.cover{margin-bottom:35px}.story{font-size:1rem}.story :global(blockquote){font-size:1.15rem}}
</style>
</head>
<body>
<SiteHeader current="blog" />
<main>
<div class="article-head"><a class="back" href="/blog/">← Tous les récits de voyage</a><p class="eyebrow">{article.data.category || 'Carnet de voyage'}</p><h1>{article.data.title}</h1><p class="description">{article.data.description}</p><p class="date">{dateFr}</p></div>
{article.data.cover && <img class="cover" src={article.data.cover} alt={`Illustration du récit : ${article.data.title}`} />}
<article class="story"><Content /></article>
<div class="end"><a href="/blog/">← Retour au carnet de voyage</a></div>
</main>
<footer><div class="wrap footer-links"><a href="/">Accueil</a><a href="/blog/">Le carnet</a><a href="/mentions-legales/">Mentions légales</a></div></footer>
</body></html>